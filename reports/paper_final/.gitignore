# Anything that contains song lyrics or audio stays on disk and out of git (repo convention:
# generations, inspection sheets and listening sets are git-ignored because they carry lyrics).
*.wav
*.mp3
*.flac
*.mid
*.abc
*.musicxml
*.svg.lyrics
**/materials/
**/audio/
**/scores/
# large per-sample dumps are regenerated by the scripts
data/*_raw.jsonl
